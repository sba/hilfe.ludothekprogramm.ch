                    "changelog": {
                        "2.4.1": {
                            "date": "08/02/2026",
                            "content": "1. [](#bugfix)\n    * Handle unreachable Embedly URLs with a clear \"no longer available\" link instead of a silent broken card\n    * Explicitly zero out image margin sides in the link preview card, for defensive consistency across any theme this shortcode is bundled with\n"
                        },
                        "2.4.0": {
                            "date": "07/11/2026",
                            "content": "1. [](#improved)\n    * Fix Grav 2 raw HTML/tagfilter escaping in Embedly, H5P, and Twitter shortcodes by moving embed scripts to the Assets API\n\n1. [](#new)\n    * Add self-hosted [linkpreviewcard] shortcode as a working replacement for legacy Embedly card\n"
                        },
                        "2.3.5": {
                            "date": "07/09/2026",
                            "content": "1. [](#improved)\n    * Add 1.7|2.0 compatibility flags\n"
                        },
                        "2.3.4": {
                            "date": "08/31/2025",
                            "content": "1. [](#improved)\n    * Minor theme cleanup\n"
                        },
                        "2.3.3": {
                            "date": "08/30/2025",
                            "content": "1. [](#improved)\n    * Changed theme author information to HibbittsDesign.org\n    * Updated demo pages in theme '_demo' folder\n\n1. [](#bugfix)\n    * Support for system.images.auto_fix_orientation in blog listing and hero template (thanks to @Snickbrack for reporting the issue)\n"
                        },
                        "2.3.2": {
                            "date": "09/05/2024",
                            "content": "1. [](#bugfix)\n    * Fixed support for custom logo (thanks to @pamtbaau for the PR)\n    "
                        },
                        "2.3.1": {
                            "date": "04/26/2022",
                            "content": "1. [](#improved)\n    * Additional support of the alias 'standalone' for 'chromeless'\n"
                        },
                        "2.3.0": {
                            "date": "09/27/2021",
                            "content": "1. [](#bugfix)\n    * Added needed script load for embedly.com embeds\n"
                        },
                        "2.2.9": {
                            "date": "09/27/2021",
                            "content": "1. [](#new)\n    * Added initial support for NextGen Editor custom media embeds\n"
                        },
                        "2.2.8": {
                            "date": "08/06/2021",
                            "content": "1. [](#bugfix)\n    * Added check for <a> (anchor tag) without href attribute\n"
                        },
                        "2.2.7": {
                            "date": "03/21/2021",
                            "content": "1. [](#improved)\n    * Updated demo pages in theme '_demo' folder\n"
                        },
                        "2.2.6": {
                            "date": "02/28/2021",
                            "content": "1. [](#improved)\n    * Reduced plugin dependencies, thanks to the new Grav Skeleton build process\n"
                        },
                        "2.2.5": {
                            "date": "02/17/2021",
                            "content": "1. [](#bugfix)\n    * Fixed incorrect variable name in iFrame template\n"
