                    "version": "0.2.31",
                    "description": "Membership on Grav \u2014 tiers, gates, one identity across MUD community plugins. Lite = signup + site.member. Pro = Admin2 Members panel, Stripe, bridges.",
                    "description_html": "<p>Membership on Grav \u2014 tiers, gates, one identity across MUD community plugins. Lite = signup + site.member. Pro = Admin2 Members panel, Stripe, bridges.</p>",
                    "description_plain": "Membership on Grav \u2014 tiers, gates, one identity across MUD community plugins. Lite = signup + site.member. Pro = Admin2 Members panel, Stripe, bridges.",
