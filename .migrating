                    "description_html": "<p>Typhoon theme utilizing the NEW Tailwind 4.1 CSS framework</p>",
                    "description_plain": "Typhoon theme utilizing the NEW Tailwind 4.1 CSS framework",
                    "icon": "bolt",
                    "author": {
                        "name": "Trilby Media, LLC",
                        "email": "hello@trilby.media"
                    },
                    "dependencies": [
                        {
                            "name": "grav",
                            "version": ">=1.7.6"
                        },
                        {
                            "name": "color-tools",
                            "version": ">=1.1.1"
