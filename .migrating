                    "content_sha256": "9517bed945916582775d38bdddc92e5e780dc321215c863995a2295e14524fd4",
                    "changelog": {
                        "1.4.2": {
                            "date": "05/01/2026",
                            "content": "1. [](#improved)\n    * Added 1.7|2.0 compatibility flags\n"
                        },
                        "1.4.1": {
                            "date": "05/08/2023",
                            "content": "1. [](#improved)   \n   * Fixed a deprecated message where `null` was being passed to `strip_tags()` function\n"
                        },
                        "1.4.0": {
                            "date": "05/13/2020",
                            "content": "1. [](#new)\n    * Added optional features to include additional reading time for images [#16](https://github.com/getgrav/grav-plugin-readingtime/pull/16)\n    * Started using composer\n1. [](#improved)   \n    * Added hungarian translation [#12](https://github.com/getgrav/grav-plugin-readingtime/pull/12) \n    * Added dutch translation [#14](https://github.com/getgrav/grav-plugin-readingtime/pull/14)\n    * PHPStan 7 fixes\n1. [](#bugfix)\n    * Fixed issue with passed in labels [#18](https://github.com/getgrav/grav-plugin-readingtime/pull/18)\n    * Fixed plugin initialization\n"
                        },
                        "1.3.0": {
