                    "license": "CC-BY-3.0",
                    "tag_name": "V3.9.1",
                    "date": "2026-08-11T14:38:26Z",
                    "release_type": "stable",
                    "zipball_url": "https://getgrav.org/download/themes/future2021/3.9.0",
                    "repository": "https://github.com/pmoreno-rodriguez/grav-theme-future2021",
                    "slug": "future2021",
                    "install_path": "user/themes/future2021",
                    "content_sha256": "1c2029c6cd93af09c330433e10fb978dddcf71ac9db32654df91f399eca12c4c",
                    "screenshot": "themes-future2021.jpg",
                    "changelog": {
                        "3.9.0": {
                            "date": "07/17/2026",
                            "content": "1. [](#improved)\n    * Removed inherited forms templates from plugin (use plugin defaults)\n    * Enhanced formdata template with better form data handling and error states\n"
                        },
                        "3.8.0": {
                            "date": "07/11/2026",
                            "content": "1. [](#new)\n    * Added Grav 1.7|2.0 compatibility flags\n2. [](#improved)\n    * Updated Twig templates for Twig 3 compatibility.\n    * Refactored date template to remove unsupported plugin dependencies until they have proper Grav 2.x support.\n    * Applied non-functional code style fixes to Twig templates\n"
                        },
                        "3.7.0": {
                            "date": "06/09/2026",
                            "content": "1. [](#improved)\n    * refactor: modernize theme main PHP class and improve code architecture\n"
                        },
                        "3.6.3": {
                            "date": "06/09/2026",
                            "content": "1. [](#bugfix)\n    * fix: control custom assets loading via PHP theme config only\n"
                        },
                        "3.6.2": {
                            "date": "06/08/2026",
                            "content": "1. [](#bugfix)\n    * **Blog:** Fixed an issue where social share icons configurations from the main blog page were not properly inherited by individual article views (`item.html.twig`).\n"
                        },
                        "3.6.1": {
                            "date": "04/24/2026",
                            "content": "1. [](#bugfix)\n    * Restored the social field name in the blueprint for admin compatibility\n    "
                        },
                        "3.6.0": {
                            "date": "04/24/2026",
                            "content": "1. [](#new)\n    * Added floating social icons feature: configurable floating icons for social media, with new blueprint section and backward compatibility for previous social list configuration.\n"
                        },
                        "3.5.0": {
                            "date": "03/14/2026",
                            "content": "1. [](#new)\n    * Hierarchical subpage index: show child pages as a structured, numbered index (configurable depth)\n"
                        },
                        "3.4.0": {
                            "date": "02/24/2026",
                            "content": "1. [](#new)\n    * Added page index option to default template blueprint and translations\n"
                        },
                        "3.3.0": {
                            "date": "02/22/2026",
                            "content": "1. [](#improved)\n    * Improved TOC rendering logic and inline TOC support to avoid empty containers\n    * Replaced `header_var()` usage with explicit `page.header.*` access in theme templates\n    * Unified default values between blueprints and Twig templates\n    * Updated translations and added shadow effect to box styles\n"
                        },
                        "3.2.1": {
                            "date": "02/05/2026",
                            "content": "1. [](#improved)\n    * Completed Deutsch translations for blog share icon labels\n2. [](#bugfix)\n    * Added LinkedIn share icon checkbox for item pages\n"
                        },
                        "3.2.0": {
                            "date": "02/03/2026",
                            "content": "1. [](#new)\n    * Added new modular \"text\" template with flexible layouts (1, 2, or 3 columns) and box classes\n2. [](#improved)\n    * Improved contact template functionality\n    * Enhanced banner and features templates for improved design and presentation\n    * Fixed logo.html.twig to allow users to disable the default logo display\n    * Enhanced SCSS styles for boxes, including button positioning, link styling, and other improvements\n    * Updated translations for new features\n    * Updated demo content to showcase new text template with various box styles\n3. [](#bugfix)\n    * Fixed URL encoding issue in footer button link to properly support anchor URLs like '#'\n"
                        },
                        "3.1.0": {
                            "date": "12/29/2025",
                            "content": "1.  [](#new)\n    * French translation added (thanks to [em3link](https://github.com/em3link))\n2.  [](#improved)\n    * Twig `same as` syntax fixed for Grav 1.8 compatibility\n    * Responsive breakpoint for sidebar menu updated\n"
                        },
                        "3.0.0": {
                            "date": "11/13/2025",
                            "content": "1.  [](#improved)\n    * Improved `blog.html.twig` template for better featured image handling\n    * Language translation files have been organized separately by language in the `languages` folder for improved maintainability\n    * Pass `featured_image` and `show_image` as parameters to blog_item partial template\n    * **Important Change:** Since version 1.2.1, `featured_image` is the primary field for page images. Existing pages using `primaryImage` will continue to work, but please update your frontmatter to `featured_image` for consistency.\n"
                        },
                        "2.2.3": {
                            "date": "11/11/2025",
                            "content": "1. [](#improved)\n   * Downgraded Grav version dependency from 1.7.50 to 1.7.49.5\n"
                        },
                        "2.2.2": {
                            "date": "10/29/2025",
                            "content": "1. [](#improved)\n   * `social_style` has been added to the social icon options in the theme settings\n   * Standardized Twig template formatting using [CS fixer tool](https://github.com/VincentLanglet/Twig-CS-Fixer)\n"
                        },
                        "2.2.1": {
                            "date": "10/23/2025",
                            "content": "1. [](#bugfix)\n   * Fixed Twig template loading by adding `onTwigLoader` event to `getSubscribedEvents`\n"
                        },
                        "2.2.0": {
                            "date": "10/15/2025",
                            "content": "1. [](#improved)\n   * Refactored `metadata.html.twig` with organized structure, optimized SEO metadata generation, and removed redundant conditionals\n   * Migrated all SCSS code to modern Sass syntax (Dart Sass)\n   * **Twig Templates**: Updated output filtering practices following security best practices\n   * Refactored `onTwigSiteVariables()` to dynamically detect active theme\n   * **Changed:** Plugin dependencies are no longer automatically installed. They are now listed as recommendations in the README for manual installation and greater user control.\n   * **Refactored:** Theme configuration blueprint has been modularized into separate files (`header.yaml`, `footer.yaml`, etc.) for improved organization and maintainability.\n"
                        },
                        "2.1.2": {
                            "date": "03/13/2025",
                            "content": "1.  [](#improved)\n    * Upgraded Glightbox library to version 3.3.0 \n"
                        },
                        "2.1.1": {
