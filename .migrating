                    "changelog": {
                        "1.0.1": {
                            "date": "07-12-2023",
                            "content": "- more twig strict mode compatibility\n- do not depend on external services if you can host your assets yourself\n- minor code style enhancements\n- version bump\n"
                        },
                        "1.0.0": {
                            "date": "23-07-2023",
                            "content": "- twig strict mode compatibility\n"
                        },
                        "0.9.5": {
                            "date": "05-04-2019",
                            "content": "- apparently this can be multilingual now (French) is there.\n- also some minor fixes\n"
                        },
                        "0.9": {
