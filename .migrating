                "staticmath": {
                    "name": "StaticMath",
                    "version": "2.0.1",
                    "description": "Compiles LaTeX to static and accessible MathML using an [external rendering server](http://git.sr.ht/~fd/staticmath-server).",
                    "description_html": "<p>Compiles LaTeX to static and accessible MathML using an <a href=\"http://git.sr.ht/~fd/staticmath-server\">external rendering server</a>.</p>",
                    "description_plain": "Compiles LaTeX to static and accessible MathML using an external rendering server.",
                    "icon": "square-root-alt",
                    "author": {
                        "name": "Ersei Saggi",
