                    "content_sha256": "7fa8b45abf50a7a7fe3417b15328c1df0fed05ce1ed87f49a00a7c065309da12",
                    "changelog": {
                        "3.1.1": {
                            "date": "05/01/2026",
                            "content": "1. [](#improved)\n    * Added 1.7|2.0 compatibility flags\n"
                        },
                        "3.1.0": {
