                    "changelog": {
                        "1.3.4": {
                            "date": "11/23/2015",
                            "content": "3. [](#bugfix)\n  * Fixed [#2](https://github.com/Sommerregen/grav-plugin-dropcaps/issues/2) (PHP errors) [#3](https://github.com/Sommerregen/grav-plugin-dropcaps/pull/3)\n"
                        },
                        "1.3.3": {
