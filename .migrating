                "editorial": {
                    "name": "Editorial",
                    "version": "4.2.0",
                    "description": "GravCMS port of the HTML5UP theme Editorial",
                    "description_html": "<p>GravCMS port of the HTML5UP theme Editorial</p>",
                    "description_plain": "GravCMS port of the HTML5UP theme Editorial",
                    "icon": "text-width",
                    "author": {
                        "name": "Pedro Moreno",
                        "email": "pmoreno@pmdesign.dev"
                    },
                    "dependencies": [
                        {
                            "name": "grav",
                            "version": ">=1.7.49.5"
                        }
                    ],
                    "compatibility": {
                        "grav": [
                            "1.7",
                            "2.0"
                        ]
                    },
                    "homepage": "https://github.com/pmoreno-rodriguez/grav-theme-editorial",
                    "docs": "https://github.com/pmoreno-rodriguez/grav-theme-editorial/blob/main/README.md",
                    "demo": "https://editorial.pmdesign.dev/",
                    "keywords": "grav, theme, etc",
                    "bugs": "https://github.com/pmoreno-rodriguez/grav-theme-editorial/issues",
                    "license": "MIT",
                    "tag_name": "V4.2.1",
                    "date": "2026-08-11T14:47:22Z",
                    "release_type": "stable",
                    "zipball_url": "https://getgrav.org/download/themes/editorial/4.2.0",
                    "repository": "https://github.com/pmoreno-rodriguez/grav-theme-editorial",
                    "slug": "editorial",
                    "install_path": "user/themes/editorial",
                    "content_sha256": "d048a0fc675dd1c02871c82fef3840b9845385200f16171e4c7d9410ddf004c6",
                    "screenshot": "themes-editorial.jpg",
                    "changelog": {
                        "4.2.0": {
                            "date": "08/08/2026",
                            "content": "1. [](#improved)\n   * Fixed inconsistent styling for JSON feed button in sidebar ([PR#85](https://github.com/pmoreno-rodriguez/grav-theme-editorial/issues/85))\n   * Added proper header formatting for SYNDICATE section title ([PR#85](https://github.com/pmoreno-rodriguez/grav-theme-editorial/issues/85))\n   * Enhanced date localization with optional Intl plugin support for internationalized dates\n"
                        },
                        "4.1.0": {
                            "date": "07/04/2026",
                            "content": "1. [](#improved)\n   * Changed social icon field from iconpicker to text input for better compatibility\n"
                        },
                        "4.0.0": {
                            "date": "07/03/2026",
                            "content": "1. [](#improved)\n   * Added 1.7|2.0 compatibility flags\n   * Updated Twig templates for Grav 2.0 compatibility\n   * Simplified date handling - removed translate-date and twig-extensions plugins\n"
                        },
                        "3.4.0": {
                            "date": "04/23/2026",
                            "content": "1. [](#new)\n   * Added per-page social icon controls for blog item pages\n   * Added translations for the new social icon controls\n2. [](#improved)\n   * Improved button styles and recompiled main CSS assets\n   * Improved the Recent Posts modular template\n   * Hide the Featured Posts sidebar section when no featured articles are available\n"
                        },
                        "3.3.0": {
                            "date": "02/05/2026",
                            "content": "1. [](#new)\n   * Added modular Text Blocks template with configurable columns and boxed content styles.\n2. [](#improved)\n   * Improved box typography handling for links, tables, and list elements in colored boxes.\n   * Updated demo content with new Text Blocks modular page.\n"
                        },
                        "3.2.3": {
                            "date": "01/30/2026",
                            "content": "1. [](#bugfix)\n   * Fixed missing Open Sans italic font face when using locally hosted Google Fonts, preventing incorrect semibold italic rendering (thanks to [@rwamI](https://github.com/rwam)).\n"
                        },
                        "3.2.2": {
                            "date": "01/30/2026",
                            "content": "1. [](#improved)\n    * Improved Featured Posts sidebar summaries to ensure truncated text displays a proper ellipsis (`...`) instead of the escaped `&hellip;`.\n"
                        },
                        "3.2.1": {
                            "date": "01/23/2026",
                            "content": "1. [](#improved)\n    * Featured posts can now be sorted by publication date\n"
                        },
                        "3.2.0": {
                            "date": "01/21/2026",
                            "content": "1. [](#new)\n    * Added theme configuration options to control featured posts ordering (sort field and direction)\n    * Added translations for new featured posts settings\n2. [](#bugfix)\n    * Fixed featured posts sidebar not updating correctly.\n"
                        },
                        "3.1.0": {
                            "date": "01/19/2026",
                            "content": "1. [](#improved)\n   * Re-added `wordcount` Twig filter as theme extension due to Grav core regression from v1.7.50 to v1.7.49.5\n   * Refactored `editorial.php` main theme class\n"
                        },
                        "3.0.2": {
                            "date": "11/11/2025",
                            "content": "1. [](#improved)\n   * Improved CSS styles\n   * Downgraded Grav version dependency from 1.7.50 to 1.7.49.5\n   * Added page content to the `modular.html.twig` template\n"
                        },
                        "3.0.1": {
                            "date": "11/01/2025",
                            "content": "1. [](#new)\n   * New option to choose the banner's HTML headings\n2. [](#improved)\n   * Standardized Twig template formatting using [CS fixer tool](https://github.com/VincentLanglet/Twig-CS-Fixer)\n"
                        },
                        "3.0.0": {
                            "date": "10/28/2025",
                            "content": "1. [](#new)\n   * Added global SEO configuration options in theme settings\n   * Added icon type option to social media icons\n2. [](#improved)\n   * Refactored `metadata.html.twig` for better SEO management\n   * Reorganized page blueprints from blueprints to `blueprints/pages` directory\n   * Split theme `blueprints.yaml` into partial files within `blueprints/theme`\n   * Split `languages.yaml` into individual language files\n   * Improved social media meta tags implementation\n   * Changed page title variable from `title` to `page_title` to prevent conflicts with Grav core\n   * Removed [WordCount](https://learn.getgrav.org/17/themes/twig-tags-filters-functions/filters#wordcount) custom filter from theme (now part of Grav core)\n   * Updated minimum required Grav version to 1.7.50\n   * Moved dependencies from required to recommended during theme installation\n   * Changed the alignment of the image titles in the gallery [#71](https://github.com/pmoreno-rodriguez/grav-theme-editorial/issues/71)\n   * **Updated README**: Comprehensive documentation update with new features\n3. [](#bugfix)\n   * Fixed recent posts displayed in the sidebar (only published posts are shown) [#72](https://github.com/pmoreno-rodriguez/grav-theme-editorial/issues/72)\n"
                        },
                        "2.4.1": {
                            "date": "10/05/2025",
                            "content": "1. [](#new)\n   * Added German (Deutsch) language translation support (Thanks to [@oozeat](https://github.com/oozeat))\n2. [](#improved)\n   * Enhanced security in metadata template by implementing proper Twig escape filters\n   * Variables relocated from the base template to their respective partial templates\n   * Optimized SEO metadata with absolute URLs for social media compatibility\n"
                        },
                        "2.4.0": {
                            "date": "09/30/2025",
                            "content": "1. [](#new)\n   * New `WordCount` twig filter for word counting functionality\n2. [](#improved)\n   * Enhanced security across all templates by implementing Twig escape filters to prevent malicious code injection\n   * Changed apostrophes to acute accents in French translations (`languages.yaml`) to avoid escape filter conflicts\n   * Refactored `onTwigSiteVariables()` to dynamically detect active theme\n"
                        },
                        "2.3.8": {
                            "date": "08/04/2025",
                            "content": "1. [](#improved)\n   * Use Grav locator to check for custom CSS/JS files, supporting theme inheritance\n   * Update SCSS for Sass 3 compatibility\n"
                        },
                        "2.3.7": {
                            "date": "07/30/2025",
                            "content": "1. [](#improved)\n   * Added support for videos in the gallery template\n"
                        },
                        "2.3.6": {
                            "date": "07/25/2025",
                            "content": "1. [](#improved)\n   * Remove trailing slashes from void HTML tags\n   * Refactoring the posts layout from Flexbox to CSS Grid for better readability and maintainability\n   * Refactoring some SCSS styles for better structure and readability\n   * Fixed mandatory `href` attribute on `a` tags on non-routable pages\n   * Fixed HTML markup errors reported by the W3C validator (Thanks to [@Fazarel](https://github.com/Fazarel))\n2. [](#bugfix)\n   * Fixed sidebar lock position when content height changes dynamically [Issue #48](https://github.com/pmoreno-rodriguez/grav-theme-editorial/issues/48)\n"
                        },
                        "2.3.5": {
                            "date": "05/18/2025",
                            "content": "1. [](#improved)\n   * Added addressDetails to demo contact page\n2. [](#bugfix)\n   * **Fixed:** Recent Posts template now correctly respects the user-defined post limit in modular pages.\n"
                        },
                        "2.3.4": {
                            "date": "03/13/2025",
                            "content": "1. [](#improved)\n   * Upgraded Glightbox library to version 3.3.0\n   * Added theme version dynamically in HTML comment using Twig\n   * Moved sidebar partials templates into a dedicated `partials/sidebar` folder for better organization\n   * Replaced `logo.png` with `favicon.png` in the head section\n  "
                        }
                    },
                    "download": "https://getgrav.org/download/themes/editorial/4.2.0"
                },
