                    "screenshot": "themes-deliver.jpg",
                    "changelog": {
                        "1.7.3": {
                            "date": "03/18/2025",
                            "content": "1. [](#new)\n    * IMPORTANT Deliver 2.x has been forked as DeliverNext: https://github.com/pmoreno-rodriguez/grav-theme-delivernext maintained by @pmoreno-rodriguez due to backwards compatibility issues.  \n1. [](#bugfix)\n    * Fixed `extends@` syntax in blog blueprint\n"
                        },
                        "1.7.2": {
                            "date": "12/20/2021",
                            "content": "1. [](#bugfix)\n    * Fixed missing `|raw` filters in `simplesearch_base.html.twig` [#39](https://github.com/getgrav/grav-theme-deliver/issues/39)\n"
                        },
                        "1.7.1": {
                            "date": "01/15/2021",
                            "content": "1. [](#improved)\n    * Fixed autoescaping in preparation for Grav 1.7\n"
                        },
                        "1.7.0": {
                            "date": "03/21/2019",
                            "content": "1. [](#new)\n    * Set Dependency of Grav 1.5.10+ which has support for new **Deferred Block** Twig extension\n    * Implement assets rendering using **Deferred Block** Twig extension \n    "
                        },
                        "1.6.2": {
                            "date": "12/20/2016",
                            "content": "1. [](#improved)\n    * Add bottom js call in bottom block\n"
                        },
                        "1.6.1": {
                            "date": "12/10/2016",
                            "content": "1. [](#improved)\n    * Added background animation when scrolling the menu in sticky mode\n1. [](#bugfix)\n    * Fixed some mobile alignments for hamburger and search icons in sticky mode\n"
                        },
                        "1.6.0": {
                            "date": "12/09/2016",
                            "content": "1. [](#new)\n    * Add an option to have a sticky menu. Also added blueprint configuration to turn in on from the admin. Disabled by default. Uses https://github.com/bigspotteddog/ScrollToFixed\n1. [](#improved)\n    * Invert order of previous and next button in the blog posts navigation\n1. [](#bugfix)\n    * Fix forms not working as expected. Drop the form twig overrides as they break the forms, and don't really customise the output\n"
                        },
                        "1.5.0": {
                            "date": "07/14/2016",
                            "content": "1. [](#improved)\n    * Remove unneeded streams from Theme YAML\n    * Delete unused composer.json\n    * Add the `theme_config` twig var\n1. [](#bugfix)\n    * Fix missing fontawesome-webfont.woff2 file\n    * Fix slider buttons on tablet\n    * Fix setting the page language in the html tag\n"
                        },
                        "1.4.0": {
                            "date": "01/06/2016",
                            "content": "1. [](#improved)\n    * Fontawesome updated to 4.5.0\n1. [](#bugfix)\n    * Searchbox in search results fix\n"
                        },
                        "1.3.1": {
                            "date": "12/18/2015",
                            "content": "2. [](#bugfix)\n    * Added nonce support to form template\n"
                        },
                        "1.3.0": {
                            "date": "11/18/2015",
                            "content": "1. [](#new)\n    * SimpleForm replaced with Forms plugin\n2. [](#bugfix)\n    * Admin plugin bugfixes\n"
                        },
                        "1.2.0": {
                            "date": "09/18/2015",
                            "content": "1. [](#bugfix)\n    * Updated outdated blueprints\n    * Bugfix for pagination plugin\n"
                        },
                        "1.1.1": {
                            "date": "09/18/2015",
                            "content": "1. [](#improved)\n    * compatibility with newest Grav version.\n1. [](#bugfix)\n    * SimpleForm compatibility bugfixes.\n"
