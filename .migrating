                    "screenshot": "themes-bootstrap4-open-matter.jpg",
                    "changelog": {
                        "5.1.1": {
                            "date": "08/02/2026",
                            "content": "1. [](#bugfix)\n    * Handle unreachable Embedly URLs with a clear \"no longer available\" link instead of a silent broken card\n    * Explicitly zero out image margin sides in the link preview card, for defensive consistency across any theme this shortcode is bundled with\n\n"
                        },
                        "5.1.0": {
                            "date": "07/11/2026",
                            "content": "1. [](#improved)\n    * Fix Grav 2 raw HTML/tagfilter escaping in Embedly, H5P, and Twitter shortcodes by moving embed scripts to the Assets API\n"
                        },
                        "5.0.9": {
                            "date": "07/10/2026",
                            "content": "1. [](#new)\n    * Add self-hosted [linkpreviewcard] shortcode as a working replacement for legacy Embedly card\n"
                        },
                        "5.0.8": {
                            "date": "07/09/2026",
                            "content": "1. [](#improved)\n    * Add 1.7|2.0 compatibility flags\n"
                        },
                        "5.0.7": {
                            "date": "06/17/2026",
                            "content": "1. [](#bugfix)\n    * Replace any pre-registered badge shortcode handler with the theme's own to ensure compatibility\n"
                        },
                        "5.0.6": {
                            "date": "06/17/2026",
                            "content": "1. [](#bugfix)\n    * Guard against duplicate badge shortcode registration introduced in shortcode-core v6.0.0\n"
                        },
                        "5.0.5": {
                            "date": "06/10/2026",
                            "content": "1. [](#bugfix)\n    * Display navbar Logout link text with expected color\n    * Fix accordion formating CSS h2 issue\n"
                        },
                        "5.0.4": {
                            "date": "05/11/2026",
                            "content": "1. [](#improved)\n    * Add Embedly card dark mode support with Off/On/Auto (System) setting for bootstrap4-open-matter and mytheme.\n"
                        },
                        "5.0.3": {
                            "date": "05/10/2026",
                            "content": "1. [](#improved)\n    * Add dark mode support for Embedly cards gated on theme dark_mode.enabled option.\n"
                        },
                        "5.0.2": {
                            "date": "04/22/2026",
                            "content": "1. [](#improved)\n    * Streamlined Theme Style options to 2026 Refresh and Classic.\n"
                        },
                        "5.0.1": {
                            "date": "04/21/2026",
                            "content": "1. [](#improved)\n    * Update card image to use aspect-ratio 16/9 for consistent display across screen sizes\n    * Updated card layout to responsively transition from three to two to one column as screen width decreases.\n"
                        },
                        "5.0.0": {
                            "date": "04/21/2026",
                            "content": "1. [](#new)\n    * Added 2026 Refresh theme with accessibility and rendering refinements, plus Dark Mode option for all theme styles. 2025 theme and Classic theme still available via theme settings.\n1. [](#improved)\n    * Removed Bootswatch theme stylesheets. Sites using a custom Bootswatch theme should switch to a Theme Style option.\n    * Existing mytheme installations require manual update of mytheme.yaml and mytheme/blueprints.yaml to surface new Theme Style and Dark Mode options.\n"
                        },
                        "4.0.2": {
                            "date": "09/01/2025",
                            "content": "1. [](#improved)\n    * Updated demo pages in theme '_demo' folder\n    "
                        },
                        "4.0.1": {
                            "date": "08/31/2025",
                            "content": "1. [](#improved)\n    * Minor theme cleanup\n"
                        },
                        "4.0.0": {
                            "date": "08/30/2025",
                            "content": "1. [](#new)\n    * Refreshed theme (theme-2025.css), including optional dark mode. Original theme still available (theme-classic.css).\n    * Updated demo pages in theme '_demo' folder\n"
                        },
                        "3.8.4": {
                            "date": "08/25/2025",
                            "content": "1. [](#improved)\n    * Updated demo pages in theme '_demo' folder\n"
                        },
