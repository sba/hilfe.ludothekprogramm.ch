                "babel": {
                    "name": "Babel",
                    "version": "1.1.5",
                    "description": "Translation services for GRAV",
                    "description_html": "<p>Translation services for GRAV</p>",
                    "description_plain": "Translation services for GRAV",
                    "icon": "language",
                    "author": {
