                        "1.10.1": {
                            "date": "05/01/2026",
                            "content": "1. [](#improved)\n    * Added 1.7|2.0 compatibility flags\n"
                        },
                        "1.11.0": {
                            "date": "mm/dd/2023",
                            "content": "1. [](#new)\n   * Added new `onFeedCollectionProcessed()` event to modify the collection as needed.\n   * Added ability to use custom `feed: template:` in YAML frontmatter configuration without a collection defined\n"
                        },
                        "1.10.0": {
                            "date": "09/26/2023",
                            "content": "1. [](#new)\n   * Allow template overrides based on header feed config [#67](https://github.com/getgrav/grav-plugin-feed/pull/67)\n1. [](#bugfix)\n   * Fixed the `<lastBuildDate..>` that was broken\n"
                        },
                        "1.9.0": {
                            "date": "10/05/2022",
                            "content": "1. [](#new)\n   * Utilize the new `onPageHeaders()` event in Grav `1.7.37` to force UTF-8 encoding\n"
                        },
