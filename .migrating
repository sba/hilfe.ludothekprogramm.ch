                    "content_sha256": "b36d443a25e02a08f384325fdca1f6c9453bdedda6e8d9db06a697b66fe60bee",
                    "changelog": {
                        "0.3.2": {
                            "date": "2025-11-27",
                            "content": "1. [](#improved)\n    * Remove unused and unnecessary code from tabs.php\n2. [](#bugfix)\n    * Put `cfg.attribute` to use in the HTML; was hardcoded to `data-tabs` before\n"
                        },
                        "0.3.1": {
                            "date": "2025-11-27",
                            "content": "1. [](#improved)\n    * Retroactively remove v0.2.0 and v0.2.1 into v0.3.0 to hopefully fix issues with GPM\n    * Remove `composer.json` since we're not using composer for this plugin\n"
                        },
                        "0.3.0": {
                            "date": "2025-11-17",
                            "content": "1. [](#new)\n    * Built-in CSS now included (from 0.2.0)\n    * Updated to newest `tabs.js` version  (from 0.2.0)\n    * New config options, `nav_class` and `btn_class`  (from 0.2.0)\n2. [](#improved)\n    * Built-in CSS now enabled by default  (from 0.2.0)\n    * Hardcoded string in the blueprint are now coming from the language file (from 0.2.1)    \n3. [](#bugfix)\n    * Fixed crash caused by `autoload()` method trying to scan `vendor` directory when it doesn't exist\n"
                        },
                        "0.1.0": {
                            "date": "2020-04-07",
                            "content": "1. [](#new)\n    * Initial release"
                        }
                    },
                    "download": "https://getgrav.org/download/plugins/tabs/0.3.2"
                },
