                    "description_html": "<p>Automatically add meta tags and structured data to your pages for visually appealing and informative search results and social media sharing.</p>",
                    "description_plain": "Automatically add meta tags and structured data to your pages for visually appealing and informative search results and social media sharing.",
                    "icon": "code",
                    "author": {
                        "name": "Matt Mulhall",
