                    "screenshot": "themes-quark-a11y.jpg",
                    "changelog": {
                        "1.2.0": {
                            "date": " 07/06/2025",
                            "content": "1. [](#new)\n    * Enhanced keyboard navigation for mobile menu toggle (Enter and Space keys)\n    * Improved aria-expanded state management for menu accessibility\n2. [](#improved)\n    * Full Grav 2.0 compatibility while maintaining Grav 1.7 support\n    * Modernized PHP code with return type hints (PHP 8.3 compatible)\n    * Replaced Elvis operator (`?:`) with null-coalescing operator (`??`) in some Twig templates\n    * Updated Twig template syntax for Twig 3 compatibility\n    * Display Grav and theme version info in footer\n3. [](#bugfix)\n    * Fixed popular tags not displaying on blog item pages\n    * Fixed sidebar variable passing in item template for proper context inheritance\n    * Fixed taxonomy list validation to handle undefined page context gracefully\n"
                        },
                        "1.1.2": {
                            "date": " 11/01/2025",
                            "content": "1. [](#improved)\n    * Standardized Twig template formatting using [CS fixer tool](https://github.com/VincentLanglet/Twig-CS-Fixer)\n"
                        },
                        "1.1.1": {
                            "date": " 10/21/2025",
                            "content": "1. [](#bugfix)\n    * Added missing `_labels.scss` partial to `theme.scss`\n"
                        },
                        "1.1.0": {
                            "date": " 10/21/2025",
                            "content": "1. [](#improved)\n    * Added bottom border to links for better accessibility\n    * Improved color contrast for better readability\n    * Separated layout and classes in features configuration\n    * Added class field to text template blueprint\n"
                        },
                        "1.0.0": {
