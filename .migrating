                    "description": "This plugin allows you to include math formulas in your web pages, either using TeX and LaTeX notation, and/or as MathML.",
                    "description_html": "<p>This plugin allows you to include math formulas in your web pages, either using TeX and LaTeX notation, and/or as MathML.</p>",
                    "description_plain": "This plugin allows you to include math formulas in your web pages, either using TeX and LaTeX notation, and/or as MathML.",
                    "icon": "subscript",
                    "author": {
                        "name": "Sommerregen",
                        "email": "sommerregen@benjamin-regler.de"
                    },
                    "homepage": "https://github.com/sommerregen/grav-plugin-mathjax",
