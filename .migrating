                    "content_sha256": "887552e4d35b89d6397d2d6006c33b97441f44b9718eebd9752f9ebc40b65463",
                    "screenshot": "themes-canvas.jpg",
                    "changelog": {
                        "3.0.3": {
                            "date": "10/03/2024",
                            "content": "1.  [](#feature)\n    * Added support for page.menu override.\n2.  [](#bugfix)\n    * Ongoing format fix in changelog syntax.\n"
                        },
                        "3.0.2": {
                            "date": "08/08/2024",
                            "content": "1.  [](#bugfix)\n    * Removed a duplicate line causing js assets to be loaded twice.\n"
                        },
                        "3.0.1": {
                            "date": "05/05/2024",
                            "content": "1.  [](#bugfix)\n    * Updated repository links\n"
                        },
                        "3.0.0": {
                            "date": "05/04/2024",
                            "content": "1.  [](#new)\n    * Added custom js and css\n    * Added basic rss support, link will show in navigation for\n    * Added some debug vars for built-in seo and features\n2.  [](#bugfix)\n    * Refactored theme partials\n"
                        },
                        "2.6.0": {
                            "date": "05/14/2023",
                            "content": "1.  [](#bugfix)\n    * Disable use of the enable_subtitle header.\n"
                        },
                        "2.5.0": {
                            "date": "05/14/2023",
                            "content": "1.  [](#bugfix)\n    * Fixed subtitle bug potentially due to weird header parsing.\n    * Fixed theme blueprints due to weird name collision.\n"
                        },
                        "2.4.0": {
                            "date": "05/09/2023",
                            "content": "1.  [](#bugfix)\n    * Fixed featured image bug caused by blueprint system upgrade.\n"
                        },
                        "2.3.0": {
                            "date": "05/09/2023",
                            "content": "1.  [](#bugfix)\n    * Fixed date display behavior to prefer a hardcoded `publish_date` over the usual `page`.\n    * Re-committed test files for quark-based themes in the `_demo` folder.\n"
                        },
                        "2.2.0": {
                            "date": "05/08/2023",
                            "content": "1.  [](#bugfix)\n    * Replaced bug-causing old logic in `partials/header.html.twig` and `partials/base.html.twig`.\n"
                        },
                        "2.1.0": {
                            "date": "05/08/2023",
                            "content": "1.  [](#bugfix)\n    * Fixed typo in favicon url in `partials/base`.\n"
                        },
                        "2.0.0": {
                            "date": "05/08/2023",
                            "content": "1.  [](#new)\n    * BREAKING - restructured blueprint system to improve settings portability. Old settings from v1 are no longer supported due to renamed blueprint variables. See `blueprints.yaml` and `canvas.yaml` for the new variable system. All themes that use `canvas` as a starter are recommended to place all page-level blueprint schemas in `default.yaml` and let the partials and theme templates handle if they must access the values in `default.yaml` This unless you really need to lock a set of settings to a specific template.\n    * Depreciated template alias files and transferred alias handling to theme logic. This is to declutter the template list in the admin page settings. See `partials/base.html.twig` for the alias lists. If you explicitly want a template alias to appear in the page settings, you must create a new template file that embeds the official template it stands for and register it in the alias lists in `partials/base.html.twig`.\n2.  [](#bugfix)\n    * Fixed pageflip to only appear if the parent page has a `content.items` defined.\n    * Fixed missing description value.\n    * Fixed breadcrumbs to only appear in `item`-like pages.\n3.  [](#improved)\n    * Moved breadcrumbs to header. Visible to `item`-like pages only, but can be forced to be shown or hidden through setting `partials.breadcrumbs.toggle` in your page to true or false.\n"
                        },
                        "1.0.4": {
                            "date": "01/27/2023",
                            "content": "1.  [](#bugfix)\n    * Bugfix for url of user-uploaded favicon.\n"
                        },
                        "1.0.3": {
                            "date": "01/24/2023",
                            "content": "1.  [](#bugfix)\n    * Continued fix for breadcrumb css overrides.\n"
                        },
                        "1.0.2": {
                            "date": "01/24/2023",
                            "content": "1.  [](#bugfix)\n    * Fixed missing breadcrumb css overrides.\n"
                        },
                        "1.0.1": {
                            "date": "01/24/2023",
                            "content": "1.  [](#bugfix)\n    * Fixed missplaced demo pages.\n"
                        },
                        "1.0.0": {
                            "date": "01/24/2023",
                            "content": "1.  [](#new)\n    * Added demo pages.\n2.  [](#bugfix)\n    * Fixed url generation for per site custom preview page.\n3.  [](#improved)\n    * Improved `default` and `item` with pageflip urls when they are children of page listings.\n"
                        },
                        "0.9.0": {
                            "date": "01/24/2023",
                            "content": "1.  [](#new)\n    * Added support for `breadcrumbs` and `pagination` plugin\n"
                        },
                        "0.8.0": {
                            "date": "01/23/2023",
                            "content": "1.  [](#new)\n    * Added basic support for the `form` plugin\n2.  [](#bugfix)\n    * Fixed `item` template behavior\n    * Migrated `item` blueprints to `default` for aliased templates.\n3.  [](#improved)\n    * Improved handling of `modular` pages.\n"
                        },
                        "0.7.2": {
                            "date": "01/17/2023",
                            "content": "1.  [](#bugfix)\n    * Fixed url and description metadata bugs\n"
                        },
                        "0.7.1": {
                            "date": "01/17/2023",
                            "content": "1.  [](#bugfix)\n    * Used absolute urls for preview images.\n"
                        }
                    },
                    "download": "https://getgrav.org/download/themes/canvas/3.0.3"
                },
                "oxygen": {
                    "name": "Oxygen",
                    "version": "2.1.12",
                    "description": "Oxygen is a crazy fast, accessible and GDPR-compliant theme + build tools. Now with modular building blocks!",
                    "description_html": "<p>Oxygen is a crazy fast, accessible and GDPR-compliant theme + build tools. Now with modular building blocks!</p>",
                    "description_plain": "Oxygen is a crazy fast, accessible and GDPR-compliant theme + build tools. Now with modular building blocks!",
                    "icon": "sun-o",
                    "author": {
                        "name": "Kittyfish from Mars",
                        "url": "https://github.com/kittyfishfrommars"
                    },
                    "dependencies": [
                        {
                            "name": "grav",
                            "version": ">=1.7.8"
                        },
                        {
                            "name": "error"
                        },
                        {
                            "name": "markdown-notices"
                        },
                        {
                            "name": "problems"
                        },
                        {
                            "name": "sitemap"
                        }
                    ],
                    "homepage": "https://github.com/kittyfishfrommars/grav-theme-oxygen",
                    "docs": "https://github.com/kittyfishfrommars/grav-theme-oxygen/blob/main/README.md",
                    "demo": "https://kittyfishfrommars.github.io/grav/grav-theme-oxygen",
                    "keywords": "grav, theme, accessiblity, performance, maintenance, legal, gulp",
                    "bugs": "https://github.com/kittyfishfrommars/grav-theme-oxygen/issues",
                    "license": "MIT",
                    "tag_name": "v2.1.12",
                    "date": "2026-02-17T10:08:56Z",
                    "release_type": "stable",
                    "zipball_url": "https://getgrav.org/download/themes/oxygen/2.1.12",
                    "repository": "https://github.com/kittyfishfrommars/grav-theme-oxygen",
                    "slug": "oxygen",
                    "install_path": "user/themes/oxygen",
                    "content_sha256": "7c92db72058088270a52e42ee64a2bf438490f6bb29527fbbba761b552da61b5",
                    "screenshot": "themes-oxygen.jpg",
                    "changelog": {
                        "2.1.12": {
                            "date": "14-02-2026",
                            "content": "1. [](#bugfix) Fix banner image source in `_demo` files\n"
                        },
                        "2.1.11": {
                            "date": "10-10-2025",
                            "content": "1. [](#improved)\n* [#22](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/22) Add local/remote toggle for banner, thanks [@pmoreno-rodriguez](https://github.com/pmoreno-rodriguez)\n"
                        },
                        "2.1.10": {
                            "date": "03-08-2025",
                            "content": "1. [](#bugfix)\n* [#25](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/25) Fix GPM installation\n2. [](#new)\n* [PR #32](https://github.com/kittyfishfrommars/grav-theme-oxygen/pull/32) Customise site title separator character, thanks [@petira](https://github.com/petira)\n3. [](#improved)\n* [PR #31](https://github.com/kittyfishfrommars/grav-theme-oxygen/pull/31) Optionally display callout button, thanks [@petira](https://github.com/petira)\n4. [](#bugfix)\n* [PR #30](https://github.com/kittyfishfrommars/grav-theme-oxygen/pull/30) Fix module links blueprint description, thanks [@petira](https://github.com/petira)\n"
                        },
                        "2.0.0": {
                            "date": "20-03-2025",
                            "content": "1. [](#new)\n* **Oxygen v2.0.0 Breaking Changes:** This major release improves integration with the admin panel. Please import all [_demo](https://github.com/kittyfishfrommars/grav-theme-oxygen/tree/main/_demo) content for a new data structure\n* Introduce modules as building blocks\n* [#3](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/3) Add configurable pages\n* [#7](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/7) Add dynamic footer links\n* [#6](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/6) Add full-width hooks section\n2. [](#improved)\n* Improved and simplified error and sitemap pages\n* Add cs language support to sitemap, thanks [@petira](https://github.com/petira)\n* Layout fixes: hover styles to main navigation, font-sizes, margins/paddings\n* [#11](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/11) Add CSS or image float in content\n* [#8](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/2) Allow link lists with relative URLs in admin panel\n* [#5](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/2) Update README with more detailed [Setup Instructions](https://github.com/kittyfishfrommars/grav-theme-oxygen/tree/main?tab=readme-ov-file#setup)\n3. [](#bugfix)\n* [#13](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/13) Permanently highlight active child items in navigation\n* [#4](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/4) Correctly save footer values in admin panel\n* [#2](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/2) Fix fontawesome reference for inherited themes\n* [#1](https://github.com/kittyfishfrommars/grav-theme-oxygen/issues/1) Update sidebar examples\n* ...and flimsy sample story\n"
                        },
                        "1.0.4": {
                            "date": "14-10-2024",
                            "content": "1. [](#bugfix)\n* Decrease logo font-size for tablet (<1280), slightly decrease navigation item margins\n"
                        },
                        "1.0.3": {
                            "date": "13-10-2024",
                            "content": "1. [](#new)\n* Add page-specific [Theme Option](https://github.com/kittyfishfrommars/grav-theme-oxygen/blob/main/README.md#page-options) for granular control of search engine indexing by page. Make sure to also enable [site-wide indexing](https://github.com/kittyfishfrommars/grav-theme-oxygen/blob/main/README.md#theme-options) once you go live.\n"
                        },
                        "1.0.2": {
                            "date": "08-08-2024",
                            "content": "1. [](#new)\n* Add site-wide [Theme Option](https://github.com/kittyfishfrommars/grav-theme-oxygen/blob/main/README.md#theme-options) to enable search engine indexing (default: disabled - indexing is not allowed)\n2. [](#improved)\n* Include sample `user/env/mysite.com` folder for production settings, see [README](https://github.com/kittyfishfrommars/grav-theme-oxygen/blob/main/README.md#environments)\n"
                        },
                        "1.0.1": {
                            "date": "17-07-2024",
                            "content": "1. [](#new)\n* Add gulp taskrunner build tools, usage `npm run serve` and `npm run build`, see [README](https://github.com/kittyfishfrommars/grav-theme-oxygen/blob/main/README.md#build-tools)\n2. [](#improved)\n* Update jQuery to v3.6.1 to improve plugin compatibility\n3. [](#bugfix)\n* Fix show logo on narrow screens\n* Fix profile image size on narrow screens\n"
                        },
                        "1.0.0": {
                            "date": "14-02-2024",
                            "content": "1. [Release](#release)\n    1. [](#new)\n        - Oxygen by [kittyfishfrommars](https://github.com/kittyfishfrommars) is a continuation of [hughbris](https://github.com/hughbris/grav-theme-solarize) work for [Grav CMS](http://github.com/getgrav/grav)\n2. [Accessibility](#accessibility)\n    1. [](#new)\n        - Typography: increase font-size, unify line-height to improve readability\n        - Footer icons: add aria-label for screenreaders to footer icons\n        - Color scheme: change background from white to light grey to reduce eye-strain\n        - Contrast: new color scheme to pass accessibility audit\n3. [Performance](#performance)\n    1. [](#new)\n        - Remove IE8 support\n        - Improve JS/CSS loading strategy\n        - Refactor JS/CSS folders for easier automation\n        - Convert iconfont to woff2\n        - Introduce fingerprints to help with [Cache-Control](https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Cache-Control) busting\n4. [Maintenance](#maintenance)\n    1. [](#new)\n        - Set header banner on a per-page basis in admin panel\n        - Define footer content on a per-site basis in admin panel\n        - Configure sidebars on a per-page basis in admin panel\n        - Add modular links to be configured in admin panel\n        - Add custom error page via [grav-plugin-error](https://github.com/getgrav/grav-plugin-error) dependency\n        - Add XML sitemap and custom HTML sitemap via [grav-plugin-sitemap](https://github.com/getgrav/grav-plugin-sitemap)\n        - Dynamically refer to sitemap from error page\n        - Add languages.yaml in theme root to customize plugin messages\n        - Introduce optional helper classes to style some components via yaml\n        - Refactor notices to CSS grid, set individual icons and colors in page, fix overlong texts\n        - Configurable grid\n        - Add overview of FontAwesome 4.0.3 to elements page\n        - Add svg to hamburger menu to become truly iconfont agnostic, allowing updates\n        - Predefined settings for `user/env/config/localhost` and `user/env/config/mysite.com` environments\n5. [Legal](#legal)\n    1. [](#new)\n        - Host fonts locally to comply with [GDPR](https://www.cookieyes.com/documentation/features/integrations/google-fonts-and-gdpr/) in the EU\n        - Disable popularity statistics by default to eliminate the need for a cookie banner\n        - Add default Contact/Legal Notice page, as required by [national law](https://secureprivacy.ai/blog/what-is-an-impressum)\n        - Link to Legal Notice in footer\n        - Add credits and licenses\n        - Add privacy policy placeholder, to be updated by yourself"
                        }
                    },
                    "download": "https://getgrav.org/download/themes/oxygen/2.1.12"
                },
                "mundana": {
                    "name": "Mundana",
                    "version": "2.4.0",
                    "description": "Mundana Jekyll Theme ported to Grav",
                    "description_html": "<p>Mundana Jekyll Theme ported to Grav</p>",
                    "description_plain": "Mundana Jekyll Theme ported to Grav",
                    "icon": "microchip",
                    "author": {
                        "name": "Pedro Moreno",
                        "url": "https://pmdesign.dev",
                        "email": "pmoreno@pmdesign.dev"
                    },
                    "dependencies": [
                        {
                            "name": "grav",
                            "version": ">=1.7.49.5"
                        }
                    ],
                    "compatibility": {
                        "grav": [
                            "1.7",
                            "2.0"
                        ]
                    },
                    "homepage": "https://github.com/pmoreno-rodriguez/grav-theme-mundana",
                    "docs": "https://github.com/pmoreno-rodriguez/grav-theme-mundana/blob/main/README.md",
                    "demo": "https://mundana.pmdesign.dev/",
                    "keywords": "theme, core, modern, fast, responsive, html5, css3",
                    "bugs": "https://github.com/pmoreno-rodriguez/grav-theme-mundana/issues",
                    "license": "MIT",
                    "tag_name": "V2.4.0",
                    "date": "2026-07-12T16:53:21Z",
                    "release_type": "stable",
                    "zipball_url": "https://getgrav.org/download/themes/mundana/2.4.0",
                    "repository": "https://github.com/pmoreno-rodriguez/grav-theme-mundana",
                    "slug": "mundana",
                    "install_path": "user/themes/mundana",
                    "content_sha256": "1aa25287507e3f0585bb6dec1a179e52c42dc42d5b5fd62cffaef1f22b6ad9f5",
                    "screenshot": "themes-mundana.jpg",
                    "changelog": {
                        "2.4.0": {
                            "date": "07/12/2026",
                            "content": "1.  [](#improved)\n    * Added `compatibility.grav: ['1.7', '2.0']` flag\n    * Fixed inline `for ... if` loop filters (removed in Twig 3) in modular templates, replaced with `|filter(...)`\n    * Added explicit `: array` return type in `mundana.php`\n2.  [](#bugfix)\n    * Fixed incorrect `theme_var` call in `base.html.twig`\n"
                        },
                        "2.3.0": {
                            "date": "03/17/2026",
                            "content": "1.  [](#improved)\n    * Security hardening: systematic escaping, rel attributes for external links, dynamic CSS sanitization, JS defer, refactored category/related loops, JS escaping for Disqus config.\n    * Performance: optimized queries and loops in blog/sidebar partials.\n    * Accessibility: improved heading hierarchy, aria-labels for links, aria-current for active category, alt attributes for images.\n    * Fixed pagination URL construction in pagination.html.twig\n"
                        },
                        "2.2.3": {
                            "date": "02/06/2026",
                            "content": "1.  [](#improved)\n    * Updated alert colors for `alert-primary` and `alert-white` to improve contrast and differentiation\n2.  [](#bugfix)\n    * Only load `custom.css` and `custom.js` on the frontend (skip Admin)\n"
                        },
                        "2.2.2": {
                            "date": "11/11/2025",
                            "content": "1. [](#improved)\n   * Downgraded Grav version dependency from 1.7.50 to 1.7.49.5\n"
                        },
                        "2.2.0": {
                            "date": "11/01/2025",
                            "content": "1.  [](#improved)\n    * Removed [WordCount](https://learn.getgrav.org/17/themes/twig-tags-filters-functions/filters#wordcount) custom filter from theme (now part of Grav core)\n    * Moved dependencies from required to recommended during theme installation\n    * Added global Twig variables in `common_variables.html.twig` for consistent theming\n    * Standardized Twig template formatting using [CS fixer tool](https://github.com/VincentLanglet/Twig-CS-Fixer)\n"
                        },
                        "2.1.0": {
                            "date": "09/25/2025",
                            "content": "1.  [](#improved)\n    * **Asset Management**: Replaced `file_exists()` method with `$grav['locator']->findResource()` for better stream compatibility and custom assets detection\n    * **WordCount Extension**: Complete rewrite with internationalization support and modern Twig standards\n    * **Twig Templates**: Updated output filtering practices following security best practices\n    * **Template Structure**: Moved avatar and author display to blog-specific templates for clearer content type separation\n"
                        },
                        "2.0.0": {
                            "date": "09/15/2025",
                            "content": "1.  [](#new)\n    * New `navbar.use_page_color` setting to automatically match navbar color with individual page colors\n2.  [](#improved)\n    * Modular blueprint structure: Split main `blueprints.yaml` file into organized components within `blueprints/theme/` directory\n    * Moved default template page options from \"Page Settings\" tab to \"Options\" tab for better organization\n    * Relocated author page options from default template blueprint to `item.yaml` template (now only appears on blog articles)\n    * Enhanced reading time template with proper datetime attributes (`PT{minutes}M{seconds}S`) for better accessibility and SEO. Thanks to [Librist-org](https://github.com/Librist-org)\n    * Replaced `|raw` filter with `|e('html')` filter across all page titles in Twig templates for improved security\n    * Fixed `featured.html.twig` to display Featured section only when posts are tagged with 'featured' taxonomy\n    * Automatic text style adjustment (light/dark) based on navbar background color\n3.  [](#bugfix)\n    * Removed redundant `<span>` tags from various templates. Thanks to [Librist-org](https://github.com/Librist-org)\n    * Fixed `latestposts.html.twig` to show only published posts in listings\n    * Fixed `categories.html.twig` error when unpublished posts were present on pages with categories partial\n    * Corrected `favicon.html.twig` to properly display favicon image instead of just the file path\n"
                        },
                        "1.4.1": {
                            "date": "08/23/2025",
                            "content": "1.  [](#improved)  \n    * HTML error corrections. Thanks to [Librist-org](https://github.com/Librist-org)\n    * Remove trailing slashes from void HTML tags\n"
                        },
                        "1.4.0": {
                            "date": "08/17/2025",
                            "content": "1.  [](#improved)  \n    * Updated `bootstrap.min.js` to version `v4.6.2`. Thanks to [Librist-org](https://github.com/Librist-org)\n    * Added option to load Google Fonts and Bootstrap styles locally or remotely. Thanks to [Librist-org](https://github.com/Librist-org)\n"
                        },
                        "1.3.4": {
                            "date": "03/13/2025",
                            "content": "1.  [](#improved)\n    * Updated `partials/taxonomylist.html.twig` to support latest updates in that plugin\n"
                        },
                        "1.3.3": {
                            "date": "11/11/2024",
                            "content": "1.  [](#improved)\n    * Normalized some css styles [(PR#16)](https://github.com/pmoreno-rodriguez/grav-theme-mundana/issues/16)\n    * Removed the `custom.js` and `custom.css` files from the theme, to avoid overwriting user customizations with the release of new versions. These files are now loaded, if they exist in the theme's `assets/css` or `assets/js` folder, using the `onTwigSiteVariables` function within `mundana.php` and can be enabled from the theme settings [(PR#16)](https://github.com/pmoreno-rodriguez/grav-theme-mundana/issues/16).\n"
                        },
                        "1.3.2": {
                            "date": "11/10/2024",
                            "content": "1.  [](#improved)\n    * Replaced `convert_encoding('ISO-8859-1', 'HTML-ENTITIES')` with `|e('html_attr')` for better HTML attribute handling\n    * Changed size of firs-letter class to avoid overflow in notices\n    * Prepared for Grav 1.8\n"
                        },
                        "1.3.1": {
                            "date": "05/16/2024",
                            "content": "1.  [](#new)\n    * New `data.html.twig` template with rendered markdown on labels.\n2.  [](#improved)\n    * Fixed no summary data on `thankyou` page [#14](https://github.com/pmoreno-rodriguez/grav-theme-mundana/issues/14)\n    * Fixed `alert-light` color in theme.css [#15](https://github.com/pmoreno-rodriguez/grav-theme-mundana/issues/15)\n  "
                        },
                        "1.3.0": {
                            "date": "04/24/2024",
                            "content": "1.  [](#improved)\n    * Redesigned Bootstrap Shortcodes for Mundana Theme\n    * Updated contact page in demo content\n    * Added Shortcode-core to dependencies in theme blueprints\n  "
                        },
                        "1.2.1": {
                            "date": "04/21/2024",
                            "content": "1.  [](#new)\n    * New `thankyou` page in demo content, for contact form\n\n2.  [](#improved)\n    * Fixed some French translations ([PR#10](https://github.com/pmoreno-rodriguez/grav-theme-mundana/pull/10))\n    * Updated `taxonomylist` partial template to latest changes of [taxonomylist plugin](https://github.com/getgrav/grav-plugin-taxonomylist/releases/tag/1.3.6)\n    * Improved design of partial templates for categories and related pages.\n  "
                        },
                        "1.2.0": {
                            "date": "03/22/2024",
                            "content": "1.  [](#new)\n    * French translation (thanks to [ventoux84](https://github.com/ventoux84))\n2.  [](#improved)\n    * Fixed translation for \"View all posts\" in Allstories template (issue [#6](https://github.com/pmoreno-rodriguez/grav-theme-mundana/issues/6))\n3.  [](#bugfix)\n    * Fixed `featuredposts_tag` in base and allstories templates\n"
                        },
                        "1.1.0": {
                            "date": "03/17/2024",
                            "content": "1.  [](#new)\n    * Added option to show summary on pages (issue [#3](https://github.com/pmoreno-rodriguez/grav-theme-mundana/issues/3))\n    * New Twig filter to count words per page to improve SEO\n2.  [](#improved)\n    * Fixed translation for \"Read article\" in Sticky template (issue [#5](https://github.com/pmoreno-rodriguez/grav-theme-mundana/issues/5))\n  "
                        },
                        "1.0.1": {
                            "date": "12/31/2023",
                            "content": "1.  [](#new)\n    * Added support for Langswitcher plugin in the navigation bar\n2.  [](#bugfix)\n    * Fixed menu options (issue [#1](https://github.com/pmoreno-rodriguez/grav-theme-mundana/issues/1))\n  "
                        },
                        "1.0.0": {
                            "date": "12/22/2023",
                            "content": "1.  [](#new)\n    * Initial release"
                        }
                    },
                    "download": "https://getgrav.org/download/themes/mundana/2.4.0"
                },
                "patron": {
                    "name": "Patron",
                    "version": "2.0.0",
                    "description": "Patron theme originally made for non-profit organization",
                    "description_html": "<p>Patron theme originally made for non-profit organization</p>",
                    "description_plain": "Patron theme originally made for non-profit organization",
                    "icon": "asterisk",
                    "author": {
