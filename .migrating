                        "1.1.0": {
                            "date": " 01-05-2019",
                            "content": "1. [](#new)\n    * default options for galleries and single pages\n    * support for images\n    * configurable via Admin\n2. [](#improved)\n    * updated Usage and Future Plans sections of README\n    * more language support\n"
                        },
